# Fra Neon: Dashboard -> Connect -> connection string
DATABASE_URL=postgresql://bruger:adgangskode@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Den fælles adgangskode I begge bruger til at logge ind
APP_PASSWORD=vælg-en-adgangskode

# Lang tilfældig tekst (bruges til at signere login-cookien), fx fra: openssl rand -hex 32
SESSION_SECRET=skriv-en-lang-tilfaeldig-tekst-her
